# Copy to .env and edit.
GPU_PROFILE=rtxpro6000        # a2000 | rtxpro6000
GPU_DEVICE=0                  # GPU index on this host
# Pin a model commit in production (hf: nvidia/Nemotron-3.5-Parse commits)
MODEL_REVISION=main
BIND_ADDR=127.0.0.1           # 0.0.0.0 to expose on the LAN (then set VLLM_API_KEY)
HOST_PORT=8000
VLLM_API_KEY=
HF_TOKEN=
