# NVIDIA RTX PRO 6000 Blackwell (sm_120, 96 GB GDDR7)
# Leave attention on vLLM's default (FA3 is Hopper-only; on sm_120 vLLM picks FA2).
# If parsing output looks malformed, try: --attention-backend TRITON_ATTN
EXTRA_VLLM_ARGS=
# Model card's throughput setting.
MAX_NUM_SEQS=192
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=16384
MAX_NUM_BATCHED_TOKENS=16384
