# NVIDIA RTX A2000 (Ampere sm_86, 6 GB or 12 GB GDDR6)
# FA3 is Hopper-only; NVIDIA recommends Triton attention on Ampere for
# Nemotron Parse (A100/A10 guidance on the earlier Parse model cards).
EXTRA_VLLM_ARGS=--attention-backend TRITON_ATTN
# Weights are ~1.3 GB (0.63B, BF16); the rest is KV cache.
# 12 GB card: MAX_NUM_SEQS=16 / 0.90.  6 GB card or GPU also driving a display: 4 / 0.80.
MAX_NUM_SEQS=8
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=16384
MAX_NUM_BATCHED_TOKENS=16384
